generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String @id @default(uuid())
  name      String
  legalName String
  cnpj      String @unique
  email     String @unique
  slug      String @unique
  conta     String @unique // identificador do tenant usado no login
  type      String @default("tenant") // "master" | "tenant"
  status    String

  users         User[]
  stores        Store[]
  terminals     Terminal[]
  medias        Media[]
  campaigns     Campaign[]
  notifications Notification[]
  integrations  CompanyIntegration[]
  offers        Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String
  password String
  isActive Boolean @default(true)
  isOwner  Boolean @default(false)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  terminalActivations TerminalActivation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, companyId])
  @@map("users")
}

model Store {
  id      String  @id @default(uuid())
  name    String
  address String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  terminalLayoutId String?
  terminalLayout   TerminalLayout? @relation(fields: [terminalLayoutId], references: [id], onDelete: SetNull)

  terminals        Terminal[]
  license          StoreLicense?
  campaigns        Campaign[]
  campaignProducts CampaignProduct[]
  integrations     CompanyIntegration[]
  medias           Media[]
  offers           Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([terminalLayoutId])
  @@map("stores")
}

model Terminal {
  id       String  @id @default(uuid())
  name     String
  ip       String? @unique
  location String

  isPriceChecker Boolean   @default(true)
  isMediaDisplay Boolean   @default(false)
  isActive       Boolean   @default(false)
  isBlocked      Boolean   @default(false)
  activationCode String?   @unique
  lastSeenAt     DateTime?

  revokedAt DateTime?
  revokedBy String? // userId de quem revogou

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  credential            TerminalCredential?
  activations           TerminalActivation[]
  terminalMedias        TerminalMedia[]
  heartbeats            TerminalHeartbeat[]
  events                TerminalEvent[]
  campaigns             Campaign[]
  activationCodeHistory ActivationCodeHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("terminals")
}

model TerminalCredential {
  id        String    @id @default(uuid())
  token     String    @unique
  status    String    @default("ACTIVE") // ACTIVE | REVOKED
  expiresAt DateTime?
  revokedAt DateTime?

  terminalId String   @unique
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("terminal_credentials")
}

model TerminalActivation {
  id          String    @id @default(uuid())
  activatedAt DateTime  @default(now())
  status      String    @default("USED") // PENDING | USED | EXPIRED | REVOKED
  revokedAt   DateTime?
  revokedBy   String? // userId de quem revogou

  terminalId String
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  activatedByUserId String?
  activatedByUser   User?   @relation(fields: [activatedByUserId], references: [id], onDelete: SetNull)

  @@map("terminal_activations")
}

model StoreLicense {
  id            String   @id @default(uuid())
  quantityTotal Int
  quantityUsed  Int      @default(0)
  startsAt      DateTime
  expiresAt     DateTime
  status        String // active | expired | suspended

  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  renewals LicenseRenewal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store_licenses")
}

model LicenseRenewal {
  id                String   @id @default(uuid())
  previousExpiresAt DateTime
  newExpiresAt      DateTime
  addedQuantity     Int

  storeLicenseId String
  storeLicense   StoreLicense @relation(fields: [storeLicenseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("license_renewals")
}

model Campaign {
  id       String   @id @default(uuid())
  name     String
  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  terminalId String?
  terminal   Terminal? @relation(fields: [terminalId], references: [id], onDelete: SetNull)

  thumbnail String? // emoji character chosen by user

  terminalMedias TerminalMedia[]
  products       CampaignProduct[]
  logs           CampaignLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campaigns")
}

// Snapshot dos produtos vinculados à campanha. Os preços e o nome são
// "congelados" no momento em que o produto é adicionado — preserva o
// histórico mesmo se o produto for atualizado depois.
model CampaignProduct {
  id String @id @default(uuid())

  // Snapshot — não é atualizado depois
  ean         String
  productName String
  preco1      Decimal? @db.Decimal(10, 2)
  preco2      Decimal? @db.Decimal(10, 2)
  preco3      Decimal? @db.Decimal(10, 2)
  imageUrl    String?

  // Referência ao produto original na tabela tenant<store>.products
  // (sem FK pois é cross-schema; só pra rastreabilidade)
  productId String?

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([campaignId, ean])
  @@index([campaignId])
  @@index([storeId])
  @@map("campaign_products")
}

model CampaignLog {
  id          String @id @default(uuid())
  action      String // "created" | "updated" | "media_added" | "media_removed" | "deleted"
  description String
  userId      String
  userName    String
  diff        Json? // { field: { from: any, to: any } }

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("campaign_logs")
}

model Media {
  id           String  @id @default(uuid())
  bucket       String
  path         String  @unique
  url          String?
  fileName     String
  originalName String?
  mimeType     String
  size         Int
  type         String // image | video

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  terminalMedias TerminalMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@map("media")
}

model TerminalMedia {
  id             String    @id @default(uuid())
  order          Int       @default(0)
  duration       Int? // segundos de exibição para imagens; null para vídeos (toca até o fim)
  // Animação de entrada exibida pelo app ao mostrar este item.
  // Valores aceitos: 'none' | 'fade' | 'zoom' | 'bounce' | 'slideLeft' | 'slideUp'
  enterAnimation String    @default("none")
  startsAt       DateTime?
  endsAt         DateTime?

  terminalId String
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  // Slot do tipo mídia (imagem/vídeo). Mutuamente exclusivo com offerId.
  mediaId String?
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  // Slot do tipo oferta (renderiza um OfferLayout com dados da Offer).
  offerId String?
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([terminalId, mediaId, campaignId])
  @@unique([terminalId, offerId, campaignId])
  @@index([offerId])
  @@map("terminal_medias")
}

model TerminalHeartbeat {
  id         String  @id @default(uuid())
  ip         String?
  appVersion String?

  terminalId String
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("terminal_heartbeats")
}

model TerminalEvent {
  id      String @id @default(uuid())
  type    String
  payload Json?

  terminalId String
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("terminal_events")
}

model ActivationCodeHistory {
  id   String @id @default(uuid())
  code String @unique

  terminalId String
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("activation_code_history")
}

model Configuration {
  id        String    @id @default(uuid())
  resetTime Int       @default(30)
  lastSync  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("configurations")
}

model Integration {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  category    String
  description String
  logoLetters String  @default("??")
  logoColor   String  @default("from-muted to-muted/60")
  isActive    Boolean @default(true)
  fields      Json    @default("[]")
  features    Json    @default("[]")

  // n8n — cada feature tem seu próprio workflowJson dentro do array features
  n8nApiUrl String? // URL da instância n8n (ex: https://n8n.empresa.com)
  n8nApiKey String? // API key do n8n

  companyIntegrations CompanyIntegration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integrations")
}

model IntegrationCategory {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integration_categories")
}

model CompanyIntegration {
  id        String  @id @default(uuid())
  slug      String
  isEnabled Boolean @default(false)
  config    Json    @default("{}") // campos livres: account, token, etc.
  features  Json    @default("[]") // lista de keys de features ativas

  // mapa de featureKey → workflowId no n8n (um workflow por feature)
  n8nWorkflowId Json? // ex: { "update_price": "123", "update_product": "456" }

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, storeId])
  @@map("company_integrations")
}

model Notification {
  id          String    @id @default(uuid())
  title       String
  body        String
  type        String    @default("info") // info | warning | danger | success
  actionLabel String?
  actionUrl   String?
  isRead      Boolean   @default(false)
  readAt      DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

// Layouts de oferta — criados pelo master e reusáveis por todas as lojas.
// Cada categoria reflete um tipo de oferta:
//   "oferta_item"           — uma oferta de 1 produto
//   "leve_x_pague_y"        — leve X, pague Y (múltiplos itens)
//   "compre_ganhe_brinde"   — comprou X, ganha brinde (texto/imagem)
//   "outro"                 — qualquer outro
model OfferLayout {
  id            String  @id @default(uuid())
  slug          String? @unique
  category      String // ver acima
  name          String
  description   String?
  orientation   String  @default("portrait") // "portrait" | "landscape"
  backgroundUrl String? // URL pública (Supabase) de uma imagem de fundo opcional
  template      String  @default("") // código HTML-like com Tailwind + ${...}
  isActive      Boolean @default(true)
  thumbnailUrl  String?

  offers Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("offer_layouts")
}

// Ofertas — campanhas comerciais montadas em cima do catálogo da loja.
// Aparece na playlist do terminal como um "slot de oferta" (TerminalMedia.offerId).
model Offer {
  id   String @id @default(uuid())
  name String
  kind String // "oferta_item" | "leve_x_pague_y" | "compre_ganhe_brinde"

  // parâmetros do tipo
  leveX          Int? // só pra leve_x_pague_y
  pagueY         Int? // só pra leve_x_pague_y
  brindeText     String? // só pra compre_ganhe_brinde
  brindeImageUrl String? // só pra compre_ganhe_brinde

  // URL pública da imagem PNG renderizada pelo backend a partir do layout Konva.
  // Atualiza sempre que a oferta é (re)gerada. Usada pelo app como uma "mídia" no playlist.
  renderedImageUrl String?
  renderedAt       DateTime?

  isActive Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  layoutId String
  layout   OfferLayout @relation(fields: [layoutId], references: [id], onDelete: Restrict)

  products       OfferProduct[]
  terminalMedias TerminalMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([companyId])
  @@map("offers")
}

// Snapshot dos produtos da oferta — preserva os preços no momento de criação.
model OfferProduct {
  id String @id @default(uuid())

  // Snapshot — não atualiza depois
  ean         String
  productName String
  preco1      Decimal? @db.Decimal(10, 2)
  preco2      Decimal? @db.Decimal(10, 2)
  preco3      Decimal? @db.Decimal(10, 2)
  imageUrl    String?

  // Referência ao produto na tabela tenant<store>.products (sem FK pois é cross-schema)
  productId String?

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([offerId, ean])
  @@index([offerId])
  @@map("offer_products")
}

model TerminalLayout {
  id             String  @id @default(uuid())
  slug           String? @unique // identificador estável para seeds (opcional)
  name           String
  description    String?
  configFound    String  @default("") // código HTML-like com Tailwind para tela "produto encontrado"
  configNotFound String  @default("") // código para "produto não encontrado"
  configIdle     String  @default("") // código para tela de descanso ("Passe o produto")
  isPublic       Boolean @default(true) // sempre true por enquanto (master-only)
  isActive       Boolean @default(true)
  thumbnailUrl   String?

  stores Store[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("terminal_layouts")
}
